# Copie para %LOCALAPPDATA%\IAAutomacoes\.env (fora do OneDrive).
# IA exclusivamente local via Ollama. Não há chave ou API paga da OpenAI.
TELEGRAM_BOT_TOKEN=coloque_o_token_do_botfather
TELEGRAM_CHAT_ID=coloque_seu_chat_id
GMAIL_EMAIL=seuemail@gmail.com
# Senha de APP de 16 caracteres, nunca a senha normal da conta.
GMAIL_APP_PASSWORD=coloque_a_senha_de_app
GMAIL_MAILBOX=INBOX
# Limites de volume por execução. Pendentes ficam para a próxima.
EMAIL_MAX_PER_RUN=100
EMAIL_BODY_MAX_CHARS=6000
